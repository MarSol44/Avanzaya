# Brújula de Vida — cabeceras para Cloudflare Pages (equivale al .htaccess de Apache).
# HTTPS, compresión y «todo lo desconocido muestra la app» ya los hace Cloudflare solo.

/*
  # Política de seguridad completa también como cabecera (la del <meta> de
  # index.html no admite frame-ancestors). Solo scripts del propio sitio:
  # aunque alguien consiguiera colar texto, el navegador no lo ejecutaría.
  # Si cambias la del <meta>, cambia esta igual.
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://fgpwhdfvqtlvfmmzhxsy.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Frame-Options: DENY
  # el navegador no adivina tipos de archivo
  X-Content-Type-Options: nosniff
  # no se filtra la ruta completa a sitios ajenos
  Referrer-Policy: strict-origin-when-cross-origin
  # la app no pide cámara, micrófono ni ubicación: se apagan
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=15552000

# el service worker, la página y el manifiesto nunca se guardan en frío:
# así una actualización llega el mismo día
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache, must-revalidate

# el código: se revalida, pero se reutiliza si no cambió
/app.css
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache

# los iconos no cambian salvo que se sustituyan a mano
/icons/*
  Cache-Control: public, max-age=31536000, immutable
